# Generated PDF examples. Reference PDFs under examples/original are committed.
examples/*.pdf
examples/out/

# tsc's JavaScript output — an intermediate that rollup consumes.
# Declarations go straight to dist/types/ and are committed.
build/

# Local V8 test output.
test/v8/

# Versioned build artifacts are release outputs, regenerated by `npm run build`
# and published in the npm tarball. Only the canonical dist/js_pdf.mjs and
# dist/js_pdf.min.mjs are committed.
dist/js_pdf-*.mjs

# Local checkout of the upstream Dart project used as a porting reference.
dart_pdf-master/
